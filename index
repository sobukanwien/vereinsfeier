/**
 * Sobukan Weihnachtsfeier – Anmeldung
 * Google Apps Script (an ein Google Sheet gebunden)
 *
 * EINRICHTUNG:
 * 1. Neues Google Sheet anlegen → Erweiterungen → Apps Script
 * 2. Diesen Code einfügen, ADMIN_EMAIL und EVENT_ORT anpassen, speichern
 * 3. Funktion "setup" einmal ausführen (legt Kopfzeile + Zusammenfassung an,
 *    fragt nach Berechtigungen)
 * 4. Bereitstellen → Neue Bereitstellung → Typ "Web-App"
 *      Ausführen als: Ich
 *      Zugriff: Jeder
 * 5. Die Web-App-URL in der HTML-Datei bei SHEET_URL eintragen
 *
 * Aktuellen Stand abfragen: Web-App-URL einfach im Browser öffnen.
 */

const SHEET_NAME  = 'Anmeldungen';
const ADMIN_EMAIL = 'DEINE_ADRESSE@example.com'; // ← hierhin kommt bei jeder Anmeldung eine Info
const EVENT_TITEL = 'Sobukan Weihnachtsfeier';
const EVENT_DATUM = 'Freitag, 27. November 2026, 18:00 Uhr';
const EVENT_ORT   = 'Dojo Sobukan 15';           // ← Ort anpassen

const HEADERS = ['Zeitstempel', 'Vorname', 'Nachname', 'E-Mail', 'Dojo', 'Erwachsene', 'Kinder', 'Gesamt', 'Anmerkungen'];
const COL_EMAIL = 4; // Spalte D

function setup() {
  const sheet = getSheet_();
  sheet.getRange(1, 1, 1, HEADERS.length).setValues([HEADERS]).setFontWeight('bold');
  sheet.setFrozenRows(1);

  // Zusammenfassung rechts neben der Tabelle
  sheet.getRange('K1:L4').setValues([
    ['Zusammenfassung', ''],
    ['Anmeldungen', '=COUNTA(D2:D)'],
    ['Erwachsene / Kinder', '=SUM(F2:F)&" / "&SUM(G2:G)'],
    ['Personen gesamt', '=SUM(H2:H)'],
  ]);
  sheet.getRange('K1').setFontWeight('bold');
  sheet.getRange('K4:L4').setFontWeight('bold').setBackground('#fde8ea');
  sheet.autoResizeColumns(1, 12);
}

function doPost(e) {
  const lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try {
    const d = JSON.parse(e.postData.contents);

    const firstname = clean_(d.firstname);
    const lastname  = clean_(d.lastname);
    const email     = clean_(d.email).toLowerCase();
    const dojo      = clean_(d.dojo);
    const notes     = clean_(d.notes);
    const adults    = clampInt_(d.adults);
    const kids      = clampInt_(d.kids);

    if (!firstname || !lastname || !email) return json_({ ok: false, error: 'Pflichtfelder fehlen' });

    const sheet = getSheet_();
    const row = [new Date(), firstname, lastname, email, dojo, adults, kids, adults + kids, notes];

    // Gleiche E-Mail schon vorhanden? → Zeile aktualisieren statt doppelt eintragen
    const existingRow = findRowByEmail_(sheet, email);
    const isUpdate = existingRow > 0;
    if (isUpdate) {
      sheet.getRange(existingRow, 1, 1, row.length).setValues([row]);
    } else {
      sheet.appendRow(row);
    }

    const totals = getTotals_(sheet);

    // Bestätigung an Teilnehmer:in
    MailApp.sendEmail({
      to: email,
      subject: `${isUpdate ? 'Aktualisiert' : 'Bestätigung'}: ${EVENT_TITEL}`,
      body:
        `Hallo ${firstname},\n\n` +
        `${isUpdate ? 'deine Anmeldung wurde aktualisiert' : 'danke für deine Anmeldung'} zur ${EVENT_TITEL}!\n\n` +
        `📅 ${EVENT_DATUM}\n📍 ${EVENT_ORT}\n\n` +
        `Angemeldet: ${adults} Erwachsene, ${kids} Kinder\n` +
        (notes ? `Anmerkung: ${notes}\n` : '') +
        `\nWenn sich etwas ändert, kannst du das Formular einfach nochmal mit derselben E-Mail-Adresse absenden.\n\n` +
        `Wir freuen uns auf dich!\nDein Sobukan-Team`
    });

    // Info an dich
    MailApp.sendEmail({
      to: ADMIN_EMAIL,
      subject: `${isUpdate ? '✏️ Änderung' : '🎄 Neue Anmeldung'}: ${firstname} ${lastname} (${adults + kids} P.) – gesamt ${totals.personen}`,
      body:
        `${firstname} ${lastname} <${email}>\nDojo: ${dojo || '–'}\n` +
        `Erwachsene: ${adults}, Kinder: ${kids}\nAnmerkung: ${notes || '–'}\n\n` +
        `STAND: ${totals.anmeldungen} Anmeldungen, ${totals.personen} Personen ` +
        `(${totals.erwachsene} Erwachsene, ${totals.kinder} Kinder)\n\n` +
        `Sheet: ${SpreadsheetApp.getActiveSpreadsheet().getUrl()}`
    });

    return json_({ ok: true, updated: isUpdate, totals });
  } catch (err) {
    return json_({ ok: false, error: String(err) });
  } finally {
    lock.releaseLock();
  }
}

// Web-App-URL im Browser öffnen → aktueller Stand als JSON
function doGet() {
  return json_(getTotals_(getSheet_()));
}

// ── Hilfsfunktionen ──

function getSheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  return ss.getSheetByName(SHEET_NAME) || ss.insertSheet(SHEET_NAME);
}

function findRowByEmail_(sheet, email) {
  const last = sheet.getLastRow();
  if (last < 2) return -1;
  const emails = sheet.getRange(2, COL_EMAIL, last - 1, 1).getValues();
  for (let i = 0; i < emails.length; i++) {
    if (String(emails[i][0]).toLowerCase() === email) return i + 2;
  }
  return -1;
}

function getTotals_(sheet) {
  const last = sheet.getLastRow();
  const t = { anmeldungen: 0, erwachsene: 0, kinder: 0, personen: 0 };
  if (last < 2) return t;
  sheet.getRange(2, 1, last - 1, HEADERS.length).getValues().forEach(r => {
    if (!r[COL_EMAIL - 1]) return;
    t.anmeldungen++;
    t.erwachsene += Number(r[5]) || 0;
    t.kinder     += Number(r[6]) || 0;
  });
  t.personen = t.erwachsene + t.kinder;
  return t;
}

// Text kürzen und gegen Formel-Injection im Sheet absichern
function clean_(v) {
  let s = String(v == null ? '' : v).trim().slice(0, 500);
  if (/^[=+\-@]/.test(s)) s = "'" + s;
  return s;
}

function clampInt_(v) {
  const n = parseInt(v, 10);
  return isNaN(n) ? 0 : Math.max(0, Math.min(20, n));
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}
